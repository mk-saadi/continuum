{
	"name": "continuum",
	"productName": "Continuum",
	"version": "1.0.0",
	"description": "Continuum is a floating, local-first desktop AI assistant powered by llama.cpp with MCP tool integration, persistent memory, and multi-agent support.",
	"homepage": "https://github.com/mk-saadi/placeholder",
	"repository": {
		"type": "git",
		"url": "https://github.com/mk-saadi/placeholder.git"
	},
	"private": true,
	"main": "main.js",
	"scripts": {
		"postinstall": "electron-builder install-app-deps",
		"test": "node --test tests/",
		"dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
		"dev:vite": "vite",
		"dev:electron": "cross-env NODE_ENV=development electron .",
		"build": "vite build",
		"start": "cross-env NODE_ENV=production electron .",
		"preview": "vite preview",
		"dist": "npm run build && electron-builder"
	},
	"keywords": [
		"electron",
		"react",
		"llm",
		"llama.cpp",
		"assistant",
		"mcp",
		"local-ai",
		"desktop-app"
	],
	"author": {
		"name": "mk-saadi",
		"email": "mksaadi820@gmail.com"
	},
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	},
	"overrides": {
		"@noble/hashes": "1.8.0"
	},
	"build": {
		"appId": "com.continuum.assistant",
		"productName": "Continuum",
		"directories": {
			"output": "release"
		},
		"files": [
			"dist/**/*",
			"main.js",
			"src/main/**/*.js",
			"src/preload.js",
			"preload.js",
			"src/lib/**/*.mjs"
		],
		"asarUnpack": [
			"node_modules/@playwright/**/*",
			"node_modules/playwright*/**/*"
		],
		"linux": {
			"target": [
				"AppImage",
				"deb"
			],
			"category": "Utility"
		},
		"deb": {
			"maintainer": "mk-saadi mksaadi820@gmail.com"
		}
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@vitejs/plugin-react": "^4.3.4",
		"concurrently": "^9.1.2",
		"cross-env": "^7.0.3",
		"electron": "30.5.1",
		"electron-builder": "^26.15.3",
		"tailwindcss": "^4.3.3",
		"vite": "^6.0.7",
		"wait-on": "^8.0.2"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.1",
		"@playwright/mcp": "^0.0.83",
		"@xenova/transformers": "^2.17.2",
		"better-sqlite3": "^11.10.0",
		"dompurify": "^3.4.16",
		"hyllama": "^0.2.2",
		"mermaid": "^11.17.2",
		"pdf-parse": "^2.4.5",
		"playwright": "^1.64.0-alpha-1790635538000",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-icons": "^5.7.0",
		"react-markdown": "^10.1.0",
		"react-syntax-highlighter": "^16.1.1",
		"react-toast-master": "^3.0.1",
		"rehype-raw": "^7.0.0",
		"rehype-sanitize": "^6.0.0",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"undici": "^6.28.1",
		"unified": "^11.0.5"
	}
}
